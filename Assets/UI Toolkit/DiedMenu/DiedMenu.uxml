<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/MainMenu/MainMenuStyle.uss?fileID=7433441132597879392&amp;guid=93ea96af0218fe948ad4688e700826de&amp;type=3#MainMenuStyle"/>
    <ui:VisualElement name="Container" style="flex-grow: 1; align-items: center; justify-content: space-around; align-self: stretch;">
        <ui:VisualElement name="MenuContainer" class="center" style="flex-grow: initial; align-self: center; -unity-text-align: middle-center; justify-content: center; align-items: stretch; padding-top: 5%; padding-right: 5%; padding-bottom: 5%; padding-left: 5%;">
            <ui:Label text="You Died&#10;" name="" class="header"/>
            <ui:Button text="Retry&#10;" name="btnRetry" class="btn"/>
            <ui:Button text="Quit&#10;" name="btnQuit" class="btn"/>
